# Backend environment variables
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=your_jwt_secret
NEXTAUTH_SECRET=your_nextauth_secret
FRONTEND_URL=http://localhost:3000

# Use the local checkout simulator until the real payment provider is ready.
TEST_PAYMENTS_ENABLED=true

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_GROWTH_PRICE_ID=price_growth_monthly

# Optional default admin credentials
DEFAULT_SUPERADMIN_EMAIL=superadmin@example.com
DEFAULT_SUPERADMIN_PASSWORD=Superadmin123!
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# AI Platform APIs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# SERP / Google Rank API
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
